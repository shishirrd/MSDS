    "# Null value / Missing Value Analysis\n",
    "# Summarizing null counts and percentages across all 34 columns\n",
    "null_counts = austin_spending_data.isnull().sum()\n",
    "null_pct = (null_counts / len(austin_spending_data) * 100).round(2)\n",
    "\n",
    "null_summary = pd.DataFrame({\n",
    "    'Null Count': null_counts,\n",
    "    'Null %': null_pct\n",
    "}).query('`Null Count` > 0').sort_values('Null %', ascending=False)\n",
    "\n",
    "print(f\"Total records: {len(austin_spending_data):,}\")\n",
    "print(f\"\\nColumns with missing values ({len(null_summary)} of 34):\\n\")\n",
    "print(null_summary.to_string())\n",
    "\n",
    "# Visualize null values\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.heatmap(austin_spending_data.isnull(), cbar=True, yticklabels=False, cmap='viridis')"
