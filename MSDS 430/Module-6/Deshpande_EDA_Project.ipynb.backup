     "text": [
      "Shape after dropping columns: (624138, 24)\n",
      "Columns retained: Index(['FY_DC', 'PER_CD', 'DEPT_NM', 'FUND_NM', 'DIV_NM', 'GP_NM', 'OCAT_NM',\n",
      "       'OBJ_NM', 'LGL_NM', 'VEND_CUST_CD', 'RFED_DOC_CD', 'RFED_DOC_DEPT_CD',\n",
      "       'RFED_DOC_ID', 'COMM_CD', 'COMM_DSCR', 'CHK_EFT_ISS_DT',\n",
